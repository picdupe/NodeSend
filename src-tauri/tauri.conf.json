{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "NodeSend",
    "version":  "0.1.2-build.116",
    "identifier":  "com.picdupe.nodesend",
    "mainBinaryName":  "nodesend",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://127.0.0.1:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../frontend-dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "NodeSend",
                                    "width":  1200,
                                    "height":  800,
                                    "minWidth":  960,
                                    "minHeight":  640
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "perMachine",
                                                "installerIcon":  "icons/icon.ico",
                                                "languages":  [
                                                                  "SimpChinese",
                                                                  "English"
                                                              ],
                                                "displayLanguageSelector":  false,
                                                "installerHooks":  "../scripts/nsis-hooks.nsh"
                                            }
                               }
               },
    "plugins":  {
                    "deep-link":  {
                                      "desktop":  {
                                                      "schemes":  [
                                                                      "ns"
                                                                  ]
                                                  }
                                  },
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4MEI2RDVBMjlDNzIyODIKUldTQ0lzY3BXbTBMR040YlJlZXV2eUhaVllGUjAzMW5zeW5YVGtra0x1TnI1WHMwRHRGeEdYVGwK",
                                    "endpoints":  [

                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}
